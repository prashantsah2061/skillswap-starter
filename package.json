{
  "name": "skillswap",
  "version": "0.1.0",
  "private": true,
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @skillswap/frontend --",
    "dev:frontend": "npm run dev --workspace @skillswap/frontend --",
    "dev:backend": "npm run dev --workspace @skillswap/backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace @skillswap/frontend",
    "build:backend": "npm run build --workspace @skillswap/backend",
    "start": "npm run start --workspace @skillswap/frontend",
    "start:backend": "npm run start --workspace @skillswap/backend",
    "lint": "eslint frontend backend shared",
    "typecheck": "npm run typecheck --workspaces"
  }
}
