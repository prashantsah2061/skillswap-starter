# Copy to backend/.env.local and configure privately.
# Use the same Supabase project and publishable key as the frontend.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
APP_ORIGIN=http://localhost:3000
# Never put secret/service-role keys in NEXT_PUBLIC variables.

# Keep disabled until live baseline integration and real-provider evaluation pass.
SEMANTIC_SKILL_MATCHING=false
# See docs/SEMANTIC-MATCHING.md for private provider/evaluation configuration.
