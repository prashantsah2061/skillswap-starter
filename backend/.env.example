# Optional backend workspace. Copy to backend/.env.local; use the frontend's project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
APP_ORIGIN=http://localhost:3002
# No secret or service-role key is required. The frontend also needs its own .env.local.
