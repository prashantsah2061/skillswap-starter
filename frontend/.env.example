# Copy to frontend/.env.local and configure privately.
# Use the same Supabase project and publishable key as the backend.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
APP_ORIGIN=http://localhost:3000

# Server-only backend origin; no path or trailing slash.
SKILLSWAP_BACKEND_URL=http://localhost:3002
# Never put secret/service-role keys in NEXT_PUBLIC variables.
