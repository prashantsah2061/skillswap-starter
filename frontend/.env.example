# Copy to frontend/.env.local and replace these placeholders locally.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Exact frontend origin, no trailing slash. Use your HTTPS domain on Render.
APP_ORIGIN=http://localhost:3000
# No secret or service-role key is required for ordinary user workflows.
